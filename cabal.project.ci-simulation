-- Slimmed-down project file for .github/workflows/simulation.yaml's plain
-- `cabal build`/`cabal test` job, which has no Nix, no Agda, and none of
-- the IOG-patched libsodium/secp256k1 C libraries that the Cardano stack
-- needs. cabal always solves every local package regardless of the build
-- target requested, so merely scoping `cabal build <targets>` to this
-- job's five packages isn't enough: as soon as cardano-api and friends are
-- part of the project at all (via cabal.project's source-repository-package
-- entries), cabal tries to solve them too and fails with:
--
--   Error: [Cabal-7107]
--   Could not resolve dependencies:
--   [__0] trying: cardano-api-11.0.0.0 (user goal)
--   ...
--   [__2] rejecting: cardano-crypto-praos-2.2.2.0 (conflict: pkg-config
--         package libsodium-any, not found in the pkg-config database)
--
-- This file mirrors cabal.project's repository/index-state/constraints and
-- the packages this workflow actually builds, but omits the
-- source-repository-package entries for cardano-ledger, ouroboros-consensus,
-- and cardano-api: only leios-trace-verifier needs those (via cardano-api),
-- and they're built via the Nix `sources` derivation (nix/project.nix)
-- instead. ouroboros-network, gtk2hs, and deltaq are kept: ouroboros-leios-sim
-- depends directly on the pinned ouroboros-network fork (see its .cabal
-- file), and leios-deltaq/betti0 need gtk2hs/deltaq, independent of the rest
-- of the Cardano stack.
--
-- Keep the shared bits (repository, index-state, constraints, allow-newer,
-- package flags, ouroboros-network/gtk2hs/deltaq pins) in sync with
-- cabal.project.

repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

index-state:
  , hackage.haskell.org 2026-03-26T20:21:33Z
  , cardano-haskell-packages 2026-05-02T16:21:41Z

active-repositories:
  , :rest
  , cardano-haskell-packages:override

packages:
  simulation
  leios-trace-hs
  analysis/sims/trace-processor
  analysis/deltaq/linear-leios
  post-cip/tx-measurements/betti0

tests: True

constraints:
  -- haskell.nix patch does not work for 1.6.8
  , any.crypton-x509-system < 1.6.8
  -- haskell.nix tries to use 0.7.1.5 for some reason
  , any.proto-lens >= 0.7.1.6
  -- plutus-core's `ral` caps QuickCheck < 2.16; pin the whole project there.
  , any.QuickCheck < 2.16

-- See https://github.com/haskell/cabal/issues/11663 ; worked around with these.
allow-newer:
  , io-sim:time
  , io-classes:time
  -- fgl-arbitrary's QuickCheck <2.15 upper bound is stale; it builds with 2.15.
  , fgl-arbitrary:QuickCheck

package cryptonite
  -- Use /dev/urandom rather than RDRAND for entropy.
  flags: -support_rdrand

package bitvec
  flags: -simd

