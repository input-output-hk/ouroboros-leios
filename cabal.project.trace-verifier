-- See CONTRIBUTING.md for information about when and how to update these.
-- Aligned with cardano-node leios-prototype so that cardano-api / cardano-cli
-- (used by the trace verifier) resolve against a mutually-compatible set.
-- NOTE: this file is consumed by the Nix flake (haskell.nix
-- cabalProjectFileName in nix/project.nix); it is not usable with plain
-- cabal from a fresh checkout (the trace-parser package sources are
-- Agda-generated). The default cabal.project is the separate,
-- independently-pinned simulation project — do not sync blocks between
-- the two files (see the header there).
index-state:
  , hackage.haskell.org 2026-07-15T21:58:35Z
  , cardano-haskell-packages 2026-07-27T20:44:57Z

active-repositories:
  , :rest
  , cardano-haskell-packages:override

packages:
  -- trimmed to the verifier's needs for the w31-aligned build (simulation et
  -- al. still pin the older stack and over-constrain the solver)
  leios-trace-hs
  -- leios-trace-verifier/dist/haskell is generated (Agda -> Haskell via
  -- `make -C leios-trace-verifier` or the Nix `sources` derivation in
  -- nix/project.nix) and doesn't exist in a plain checkout. Listing it here
  -- unconditionally breaks `cabal build/test all` in CI and for anyone
  -- without Agda installed (see .github/workflows/simulation.yaml, which
  -- has no Agda toolchain). The Nix build patches it in dynamically
  -- instead; run `make -C leios-trace-verifier` first to add it locally.

tests: True

constraints:
  -- cardano-crypto-class is pinned back to crypton ^>=1.0 in the SRP; a
  -- code-free ^>=1.1 refresh had swapped memory->ram and dragged the crypto
  -- closure off the still-`memory` CHaP packages (from the w32 node's
  -- cabal.project).
  , any.crypton < 1.1
  -- haskell.nix patch does not work for 1.6.8
  , any.crypton-x509-system < 1.6.8
  -- haskell.nix tries to use 0.7.1.5 for some reason
  , any.proto-lens >= 0.7.1.7
  -- plutus-core's `ral` caps QuickCheck < 2.16; pin the whole project there.
  , any.QuickCheck < 2.16

-- See https://github.com/haskell/cabal/issues/11663 ; worked around with these.
allow-newer:
  , io-sim:time
  , io-classes:time
  -- from the w32 node's cabal.project (TODO there: bump packages instead)
  , cardano-crypto-class
  -- fgl-arbitrary's QuickCheck <2.15 upper bound is stale; it builds with 2.15.
  , fgl-arbitrary:QuickCheck

package cryptonite
  -- Use /dev/urandom rather than RDRAND for entropy.
  flags: -support_rdrand

package bitvec
  flags: -simd

