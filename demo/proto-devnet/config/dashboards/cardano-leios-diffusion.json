      "id": 100,
      "panels": [],
      "title": "Fetch bandwidth — how much of what we pulled was worth pulling",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "EB body bytes split by what became of them. Good is bytes that ended up used. Invalid failed validation, evicted arrived but was dropped before use, extra was fetched beyond what was needed. These are node metrics rather than log-derived, so they survive any tracer severity change.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic-by-name" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(rate(cardano_node_metrics_leiosFetchBodyGoodBytes_counter{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "good",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(rate(cardano_node_metrics_leiosFetchBodyExtraBytes_counter{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "extra",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(rate(cardano_node_metrics_leiosFetchBodyEvictedBytes_counter{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "evicted",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(rate(cardano_node_metrics_leiosFetchBodyInvalidBytes_counter{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "invalid",
          "refId": "D"
        }
      ],
      "title": "EB body fetch bytes by outcome",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "The same split for transaction fetches. Read alongside the body panel: a body path that looks healthy while the tx path wastes bytes points at the tx cache rather than at diffusion.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic-by-name" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(rate(cardano_node_metrics_leiosFetchTxsGoodBytes_counter{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "good",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(rate(cardano_node_metrics_leiosFetchTxsExtraBytes_counter{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "extra",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(rate(cardano_node_metrics_leiosFetchTxsEvictedBytes_counter{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "evicted",
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(rate(cardano_node_metrics_leiosFetchTxsInvalidBytes_counter{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "invalid",
          "refId": "D"
        }
      ],
      "title": "Tx fetch bytes by outcome",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Share of fetched bytes that did not end up used, per node. A node consistently above its peers is fetching from somewhere that keeps losing the race, or re-fetching what it already had. Denominator guarded so a quiet node reads as no data rather than as a spike.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic-by-name" },
          "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 2, "showPoints": "never" },
          "decimals": 3,
          "max": 1,
          "min": 0,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 9 },
      "id": 3,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "(sum by (instance) (rate(cardano_node_metrics_leiosFetchBodyInvalidBytes_counter{instance=~\"$instance\"}[$__rate_interval]) + rate(cardano_node_metrics_leiosFetchBodyEvictedBytes_counter{instance=~\"$instance\"}[$__rate_interval]) + rate(cardano_node_metrics_leiosFetchBodyExtraBytes_counter{instance=~\"$instance\"}[$__rate_interval]) + rate(cardano_node_metrics_leiosFetchTxsInvalidBytes_counter{instance=~\"$instance\"}[$__rate_interval]) + rate(cardano_node_metrics_leiosFetchTxsEvictedBytes_counter{instance=~\"$instance\"}[$__rate_interval]) + rate(cardano_node_metrics_leiosFetchTxsExtraBytes_counter{instance=~\"$instance\"}[$__rate_interval]))) / (sum by (instance) (rate(cardano_node_metrics_leiosFetchBodyGoodBytes_counter{instance=~\"$instance\"}[$__rate_interval]) + rate(cardano_node_metrics_leiosFetchBodyInvalidBytes_counter{instance=~\"$instance\"}[$__rate_interval]) + rate(cardano_node_metrics_leiosFetchBodyEvictedBytes_counter{instance=~\"$instance\"}[$__rate_interval]) + rate(cardano_node_metrics_leiosFetchBodyExtraBytes_counter{instance=~\"$instance\"}[$__rate_interval]) + rate(cardano_node_metrics_leiosFetchTxsGoodBytes_counter{instance=~\"$instance\"}[$__rate_interval]) + rate(cardano_node_metrics_leiosFetchTxsInvalidBytes_counter{instance=~\"$instance\"}[$__rate_interval]) + rate(cardano_node_metrics_leiosFetchTxsEvictedBytes_counter{instance=~\"$instance\"}[$__rate_interval]) + rate(cardano_node_metrics_leiosFetchTxsExtraBytes_counter{instance=~\"$instance\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "Wasted fetch bytes, share of all bytes fetched",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Bytes the node actually took in, over the bytes the fetch scheduler asked for. The two come from independent sources — the numerator is a node metric, the denominator is derived from the scheduler's own decision trace — so this is a consistency check as much as a signal.\n\nAround 1 is healthy. Persistently below 1 means requests are going unfulfilled, which is peers not delivering rather than the scheduler misbehaving. Above 1 means more arrived than was asked for, which is duplicate or unsolicited delivery and should show up as extra or evicted bytes on the panels to the left. Denominators are guarded, so an idle node reads as no data rather than as a spike.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic-by-name" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineWidth": 2,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "dashed" }
          },
          "decimals": 2,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": 0 },
              { "color": "blue", "value": 1 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 9 },
      "id": 4,
      "options": {
        "legend": { "calcs": ["mean", "min", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(rate(cardano_node_metrics_leiosFetchBodyGoodBytes_counter{instance=~\"$instance\"}[$__rate_interval]) + rate(cardano_node_metrics_leiosFetchBodyExtraBytes_counter{instance=~\"$instance\"}[$__rate_interval]) + rate(cardano_node_metrics_leiosFetchBodyEvictedBytes_counter{instance=~\"$instance\"}[$__rate_interval]) + rate(cardano_node_metrics_leiosFetchBodyInvalidBytes_counter{instance=~\"$instance\"}[$__rate_interval])) / (sum(rate(leios_logmetrics_diffusion_fetch_body_bytes_total{instance=~\"$instance\"}[$__rate_interval])) > 0)",
          "legendFormat": "EB body delivered / requested",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(rate(cardano_node_metrics_leiosFetchTxsGoodBytes_counter{instance=~\"$instance\"}[$__rate_interval]) + rate(cardano_node_metrics_leiosFetchTxsExtraBytes_counter{instance=~\"$instance\"}[$__rate_interval]) + rate(cardano_node_metrics_leiosFetchTxsEvictedBytes_counter{instance=~\"$instance\"}[$__rate_interval]) + rate(cardano_node_metrics_leiosFetchTxsInvalidBytes_counter{instance=~\"$instance\"}[$__rate_interval])) / (sum(rate(leios_logmetrics_diffusion_fetch_tx_bytes_total{instance=~\"$instance\"}[$__rate_interval])) > 0)",
          "legendFormat": "tx delivered / requested",
          "refId": "B"
        }
      ],
      "title": "Delivered against requested bytes",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "id": 200,
      "panels": [],
      "title": "Fetch scheduler — is it keeping up, and is there anything to fetch",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Bodies the node still wants against offers any peer has advertised. Read them together: missing bodies rising while offers stay flat is diffusion failing to reach this node, missing bodies rising with offers is the scheduler falling behind. Both are gauges reported once per decision round.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic-by-name" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(leios_logmetrics_diffusion_fetch_missing_bodies{instance=~\"$instance\"})",
          "legendFormat": "missing bodies",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(leios_logmetrics_diffusion_fetch_offers_total{instance=~\"$instance\"})",
          "legendFormat": "offers held",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(leios_logmetrics_diffusion_fetch_tracked{instance=~\"$instance\"})",
          "legendFormat": "EBs tracked",
          "refId": "C"
        }
      ],
      "title": "Missing bodies against offers held",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Requests outstanding and how many peers they are spread across. A high inflight total on few peers is concentration, which makes body arrival hostage to one link.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic-by-name" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (instance) (leios_logmetrics_diffusion_fetch_inflight_total{instance=~\"$instance\"})",
          "legendFormat": "{{instance}} requests in flight",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (instance) (leios_logmetrics_diffusion_fetch_peers_inflight{instance=~\"$instance\"})",
          "legendFormat": "{{instance}} peers in flight",
          "refId": "B"
        }
      ],
      "title": "Requests in flight and peers carrying them",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "How long a decision round takes. A round is meant to be cheap; the failure worth catching is it becoming a brake on the fetch loop, so watch p99 rather than the median.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic-by-name" },
          "custom": { "drawStyle": "line", "fillOpacity": 0, "lineWidth": 2, "showPoints": "never" },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 12,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(leios_logmetrics_diffusion_fetch_decision_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "histogram_quantile(0.9, sum by (le) (rate(leios_logmetrics_diffusion_fetch_decision_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(leios_logmetrics_diffusion_fetch_decision_duration_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "title": "Fetch decision round duration",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Work the scheduler issued, as rates. Body requests are the subset that pull EB bodies; jobs are the units of work created to service them.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic-by-name" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "id": 13,
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(rate(leios_logmetrics_diffusion_fetch_requests_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "requests",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(rate(leios_logmetrics_diffusion_fetch_body_requests_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "body requests",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(rate(leios_logmetrics_diffusion_fetch_jobs_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "jobs",
          "refId": "C"
        }
      ],
      "title": "Fetch request and job rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "id": 300,
      "panels": [],
      "title": "Tx cache — what it spared, measured at two points",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Measured at body acquisition: the share of an EB's transactions that still needed full validation once the body arrived. Lower is better. This is the LeiosBodyHits view, and it is a different question from the vote-time panel beside it — this one is about what the cache held when the body landed.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 3,
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 0.3 },
              { "color": "red", "value": 0.6 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 33 },
      "id": 20,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(rate(leios_logmetrics_diffusion_body_validated_total{instance=~\"$instance\"}[$__rate_interval])) / (sum(rate(leios_logmetrics_diffusion_body_txs_total{instance=~\"$instance\"}[$__rate_interval])) > 0)",
          "legendFormat": "needed full validation",
          "refId": "A"
        }
      ],
      "title": "Needed full validation at body acquisition",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Measured at vote time: the share of an EB's transactions reapplied from the cache rather than fully applied. Higher is better. This is the LeiosEbValidated view and it is the same quantity the throughput dashboard computes in LogQL, here as a counter ratio instead.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 3,
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 0.4 },
              { "color": "green", "value": 0.7 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 33 },
      "id": 21,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(rate(leios_logmetrics_diffusion_eb_validation_reapplied_total{instance=~\"$instance\"}[$__rate_interval])) / (sum(rate(leios_logmetrics_diffusion_eb_validation_reapplied_total{instance=~\"$instance\"}[$__rate_interval]) + rate(leios_logmetrics_diffusion_eb_validation_applied_total{instance=~\"$instance\"}[$__rate_interval])) > 0)",
          "legendFormat": "reapplied",
          "refId": "A"
        }
      ],
      "title": "Cache hit rate at vote time",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "How full the tx cache is. If load sits at capacity while the validation share above is climbing, the cache is being evicted faster than it is being used and wants sizing.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic-by-name" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "decimals": 3,
          "unit": "percentunit"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "entries" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "custom.axisPlacement", "value": "right" }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 33 },
      "id": 22,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "avg(leios_logmetrics_diffusion_tx_cache_load{instance=~\"$instance\"})",
          "legendFormat": "load",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "avg(leios_logmetrics_diffusion_tx_cache_entries{instance=~\"$instance\"})",
          "legendFormat": "entries",
          "refId": "B"
        }
      ],
      "title": "Tx cache load and size",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Where an EB's transactions came from when the body arrived, as rates. Tracked and mempool hits cost nothing; validated is the expensive path; missed both is the transactions the node had never seen, which is the share that makes EB validation slow.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic-by-name" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 30,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 41 },
      "id": 23,
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
