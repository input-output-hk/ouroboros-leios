      "title": "Announcement relay",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "description": "Announcements relayed to us by upstream peers, before deduplication, per node. Compare against the deduplicated LeiosAnnouncementAccepted rate on the voting dashboard: the ratio of the two is announcement fan-in.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic-by-name" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "cps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 52 },
      "id": 30,
      "options": {
        "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "right", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
