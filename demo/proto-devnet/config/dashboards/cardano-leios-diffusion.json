      "panels": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "description": "How many upstream peers relayed each EB announcement at one node. LeiosPeerAnnouncement is emitted once per peer per newly counted announcement, so the count per ebHash is that node's fan-in.\n\nOne node at a time on purpose. Grouping by ebHash and instance together returns roughly one series per EB per node and Loki rejects it outright with \"maximum of series (500) reached\"; summing across instances instead would silently report fleet-wide relay events as though they were one node's fan-in, which is worse. Pick the node with the variable.\n\nThis is the only Loki panel here and it scans logs, so the row is collapsed by default and the query is instant rather than ranged. topk bounds the result, and an instant query only merges into a single frame in a table, not a timeseries.",
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "thresholds" },
              "custom": { "align": "auto", "cellOptions": { "type": "auto" } },
              "mappings": [],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "red", "value": 0 },
                  { "color": "yellow", "value": 2 },
                  { "color": "green", "value": 4 }
                ]
              },
              "unit": "short"
            },
            "overrides": []
          },
          "gridPos": { "h": 12, "w": 24, "x": 0, "y": 59 },
          "id": 40,
          "options": {
            "cellHeight": "sm",
            "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
            "showHeader": true,
            "sortBy": [{ "desc": true, "displayName": "Value" }]
          },
          "targets": [
            {
              "datasource": { "type": "loki", "uid": "loki" },
              "expr": "topk(25, sum by (ebHash) (count_over_time({kind=\"LeiosPeerAnnouncement\", instance=\"$fanInInstance\"} | json ebHash=\"ebHash\" [$__range])))",
              "format": "table",
              "instant": true,
              "queryType": "instant",
              "refId": "A"
            }
          ],
          "title": "Announcement fan-in — distinct peers per EB (expensive, Loki)",
          "type": "table"
        }
      ],
      "title": "Announcement fan-in (collapsed — Loki, scans logs)",
      "type": "row"
    }
