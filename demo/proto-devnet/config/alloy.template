// proto-devnet Alloy entrypoint.
//
// Structure (see also config/alloy-modules/*.alloy):
//   * Environment-specific FRONT-END below unwraps the process-compose log
//     envelope and stamps a normalized `stream` label (node | tx-firehose |
//     tx-centrifuge) from the process name. This is the ONE piece that differs
//     per environment (playground stamps `stream` from systemd_unit instead);
//     everything downstream is shared, reusable modules.
//   * The shared per-service enrichment MODULES are imported via import.file and
//     wired here. Each is a self-contained `declare` that expects a structure and
//     forwards to an injected receiver — no module hardcodes its downstream.
//   * Routing follows Pattern B (fan-out + drop-first) at the service boundary:
//     the front-end forwards every line to each service module, and each module
//     drops anything that is not its stream. The node sub-facets (voting,
//     call-trace) are CHAINED after node_enrich so each node line is still
//     written exactly once, carrying whatever the facets added.
//
//   front-end ─┬─(raw)────────────────────────────► loki.write.loki
//              ├─► node_enrich ─► leios_voting ─► call_trace ─► loki.write.loki
//              ├─► tx_firehose_enrich ───────────────────────► loki.write.loki
//              └─► tx_centrifuge_enrich (dormant here) ───────► loki.write.loki

prometheus.remote_write "prometheus" {
	endpoint {
		url = "http://127.0.0.1:9090/api/v1/write"
	}
}

prometheus.scrape "cardano_node_exporter" {
	targets = [
		{
			"__address__" = "${IP_NODE1}:${METRICS_PORT_NODE1}",
			"job"         = "integrations/cardano-node",
			"instance"    = "node1",
			"environment" = "leios",
			"group"       = "proto-devnet",
		},
		{
			"__address__" = "${IP_NODE2}:${METRICS_PORT_NODE2}",
			"job"         = "integrations/cardano-node",
			"instance"    = "node2",
			"environment" = "leios",
			"group"       = "proto-devnet",
		},
		{
			"__address__" = "${IP_NODE3}:${METRICS_PORT_NODE3}",
			"job"         = "integrations/cardano-node",
			"instance"    = "node3",
			"environment" = "leios",
			"group"       = "proto-devnet",
		},
	]

	metrics_path = "/metrics"

	scrape_timeout  = "1s"
	scrape_interval = "1s"

	forward_to = [prometheus.remote_write.prometheus.receiver]
}

loki.write "loki" {
	endpoint {
		url        = "http://localhost:3100/loki/api/v1/push"
		batch_size = "2MB"
	}
}

local.file_match "local_files" {
	path_targets = [{"__path__" = "${WORKING_DIR}/**/*.log"}]
	sync_period  = "5s"
}

loki.source.file "process_compose_log_scrape" {
	targets       = local.file_match.local_files.targets
	forward_to    = [loki.process.extract_process_compose_logs.receiver]
	tail_from_end = false
}

// FRONT-END (environment-specific): unwrap the process-compose envelope, write
// one raw process-compose copy, and stamp a normalized `stream` label from the
// process name so the shared modules can route on it. `Analyze` (and any other
// non-matching process) gets no `stream`, so every module drops it.
loki.process "extract_process_compose_logs" {
	stage.json {
		expressions = {
			level   = "level",
			process = "process",
			replica = "replica",
			message = "message",
		}
		drop_malformed = true
	}

	// Lowercase the instance label (Node1 -> node1) so it matches the instance
	// label on the prometheus scrape targets above (node1) and playground's
	// lowercase-hostname convention. The shared dashboards source $instance from
	// Loki and use it in prometheus queries (instance=~"$instance", a
	// case-sensitive match), so a casing mismatch drops the metric panels when a
	// specific instance is selected.
	stage.template {
		source   = "instance"
		template = "{{ .process | ToLower }}"
	}

	stage.labels {
		values = {
			level    = "level",
			process  = "process",
			replica  = "replica",
			instance = "instance",
		}
	}

	stage.static_labels {
		values = {
			service = "process-compose",
			type    = "process-compose",
		}
	}

	// Normalized routing label. Modules select on `stream`, never on `process`,
	// so they stay portable across environments.
	stage.match {
		selector = `{process=~"Node[0-9]+"}`
		stage.static_labels {
			values = {
				stream = "node",
			}
		}
	}

	stage.match {
		selector = `{process="TxFirehose"}`
		stage.static_labels {
			values = {
				stream = "tx-firehose",
			}
		}
	}

	stage.match {
		selector = `{process="TxCentrifuge"}`
		stage.static_labels {
			values = {
				stream = "tx-centrifuge",
			}
		}
	}

	// Body = the wrapped trace JSON; raw copy goes to loki.write.loki, and a copy
	// is fanned to each service module.
	stage.output {
		source = "message"
	}

	forward_to = [
		loki.write.loki.receiver,
		mod.node_enrich.node.receiver,
		mod.tx_firehose_enrich.firehose.receiver,
		mod.tx_centrifuge_enrich.centrifuge.receiver,
	]
}

// Shared per-service enrichment modules (config/alloy-modules/*.alloy), placed into
// ${WORKING_DIR}/alloy-modules by run.sh. import.file on a directory exposes each
// file's `declare` under this namespace.
import.file "mod" {
	filename = "${WORKING_DIR}/alloy-modules"
}

// Node chain: node_enrich -> voting -> call-trace -> terminal write. Wiring lives
// here, not inside the modules.
mod.node_enrich "node" {
	forward_to = [mod.leios_voting_enrich.vote.receiver]
}

mod.leios_voting_enrich "vote" {
	forward_to = [mod.call_trace_enrich.call.receiver]
}

mod.call_trace_enrich "call" {
	forward_to = [loki.write.loki.receiver]
}

// tx-generator services: each writes directly (single write per line).
mod.tx_firehose_enrich "firehose" {
	forward_to = [loki.write.loki.receiver]
}

mod.tx_centrifuge_enrich "centrifuge" {
	forward_to = [loki.write.loki.receiver]
}

prometheus.scrape "alloy_pipeline_metrics" {
	// Tag the loki-derived counters (cardano_node_metrics_loki_*, incl. txgen_*)
	// with environment/instance/group so they carry the same labels as
	// playground's leios_alloy_pipeline_metrics scrape -- the shared throughput
	// dashboard selects them by environment="leios".
	targets = [{
		"__address__" = "localhost:12345",
		"instance"    = "proto-devnet",
		"environment" = "leios",
		"group"       = "proto-devnet",
	}]
	forward_to      = [prometheus.remote_write.prometheus.receiver]
	scrape_timeout  = "1s"
	scrape_interval = "1s"
}
