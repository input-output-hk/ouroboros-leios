// tx_firehose_process — the tx-firehose load generator (service = "tx-firehose").
//
// Fanned directly from the front-end (a distinct service stream, written once).
// Shares the cardano-node trace envelope but is ns-discriminated
// (TxFirehose.Submit.Success|Reject), no data.kind.
//
//   Input  : firehose trace JSON in the body, service pre-stamped by the front-end.
//   Output : decoded `data` as the body.
//   Labels : service=tx-firehose, generator=firehose, level, sev, ns.
//   Metrics: txgen_submitted_total, txgen_bytes_total, txgen_rejected_total.
//
// Submitted `size` stays in the body for `| json size | unwrap size` (main's
// query-time approach); the ingest-time txgen_bytes_total is emitted too, so both
// panel styles can be compared.
declare "tx_firehose_process" {
  argument "forward_to" {}

  export "receiver" {
    value = loki.process.enrich.receiver
  }

  loki.process "enrich" {
    stage.match {
      selector = `{service!="tx-firehose"}`
      action   = "drop"
    }

    stage.json {
      expressions = {
        at   = "at",
        sev  = "sev",
        ns   = "ns",
        data = "data",
      }
      drop_malformed = true
    }

    stage.timestamp {
      source = "at"
      format = "RFC3339"
    }

    stage.labels {
      values = {
        level = "sev",
        sev   = "sev",
        ns    = "ns",
      }
    }

    stage.static_labels {
      values = {
        service   = "tx-firehose",
        generator = "firehose",
      }
    }

    stage.output {
      source = "data"
    }

    stage.match {
      selector = `{ns="TxFirehose.Submit.Success"}`

      stage.json {
        expressions = {
          size = "size",
        }
      }

      stage.metrics {
        metric.counter {
          name              = "txgen_submitted_total"
          description       = "Total txs accepted on submission"
          prefix            = "cardano_node_metrics_loki_"
          action            = "inc"
          match_all         = true
          max_idle_duration = "24h"
        }

        metric.counter {
          name              = "txgen_bytes_total"
          description       = "Total submitted tx bytes"
          prefix            = "cardano_node_metrics_loki_"
          action            = "add"
          source            = "size"
          max_idle_duration = "24h"
        }
      }
    }

    stage.match {
      selector = `{ns="TxFirehose.Submit.Reject"}`

      stage.metrics {
        metric.counter {
          name              = "txgen_rejected_total"
          description       = "Total txs rejected on submission"
          prefix            = "cardano_node_metrics_loki_"
          action            = "inc"
          match_all         = true
          max_idle_duration = "24h"
        }
      }
    }

    forward_to = argument.forward_to.value
  }
}
