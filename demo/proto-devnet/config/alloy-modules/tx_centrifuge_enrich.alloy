// tx_centrifuge_enrich — the tx-centrifuge load generator (service = "tx-centrifuge").
//
// Fanned directly from the front-end, symmetric to tx_firehose_enrich. Present
// unconditionally but DORMANT unless centrifuge is the running generator — with
// no TxCentrifuge lines it drops everything and emits zero series at zero cost.
// This is what lets an environment switch centrifuge<->firehose with no Alloy
// change: both modules are always wired in; whichever generator is absent is inert.
//
//   Input : centrifuge trace JSON in the body, `service` label stamped by the
//           front-end. Same trace-dispatcher envelope; ns-discriminated
//           (TxCentrifuge.Builder.NewTx|QueueDepth), no `data.kind`.
//   Output: decoded `data` as body, service=tx-centrifuge, bounded ns label;
//           canonical tx-generator counter (generator="centrifuge").
//
// Centrifuge has no real submitted-byte size (unlike firehose), so only the
// canonical submitted count is emitted here; a bytes estimate, if wanted, is a
// dashboard-side concern (count x avg-size) to keep the two generators comparable.
declare "tx_centrifuge_enrich" {
  argument "forward_to" {}

  export "receiver" {
    value = loki.process.enrich.receiver
  }

  loki.process "enrich" {
    stage.match {
      selector = `{service!="tx-centrifuge"}`
      action   = "drop"
    }

    stage.json {
      expressions = {
        at   = "at",
        sev  = "sev",
        ns   = "ns",
        data = "data",
      }
      drop_malformed = true
    }

    stage.timestamp {
      source = "at"
      format = "RFC3339"
    }

    stage.labels {
      values = {
        level = "sev",
        sev   = "sev",
        ns    = "ns",
      }
    }

    stage.static_labels {
      values = {
        service   = "tx-centrifuge",
        type      = "tx-centrifuge",
        generator = "centrifuge",
      }
    }

    stage.output {
      source = "data"
    }

    stage.match {
      selector = `{ns="TxCentrifuge.Builder.NewTx"}`

      stage.metrics {
        metric.counter {
          name              = "txgen_submitted_total"
          description       = "Total txs created for submission"
          prefix            = "cardano_node_metrics_loki_"
          action            = "inc"
          match_all         = true
          max_idle_duration = "24h"
        }
      }
    }

    forward_to = argument.forward_to.value
  }
}
