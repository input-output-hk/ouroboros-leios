// dozen-devnet Alloy entrypoint. Same pipeline as proto-devnet's; the only
// differences are the generated scrape target list and the process-name regex
// that routes node logs (bp1/relay11/... instead of Node1/Node2/Node3).
//
// Structure (see also config/alloy-modules/*.alloy):
//   * Environment-specific FRONT-END below is two stages: stage 1
//     (extract_process_compose_logs) unwraps the process-compose envelope and
//     writes one raw copy; stage 2 (leios_route) stamps the routing `service`
//     label (cardano-node | tx-firehose | tx-centrifuge) from the process name and
//     fans out. This is the ONE piece that differs per environment (playground
//     stamps `service` from systemd_unit and needs no raw-copy split); everything
//     downstream is shared, reusable modules.
//   * The shared per-service enrichment MODULES are imported via import.file and
//     wired here. Each is a self-contained `declare` that expects a structure and
//     forwards to an injected receiver — no module hardcodes its downstream.
//   * Routing follows Pattern B (fan-out + drop-first) at the service boundary:
//     leios_route forwards every line to each service module, and each module
//     drops anything whose `service` is not its own. The node sub-facets (voting,
//     call-trace) are CHAINED after cardano_node_process so each node line is still
//     written exactly once, carrying whatever the facets added.
//
//   extract ─┬─(raw process-compose)────────────────────────────────► loki.write.loki
//            └─► leios_route ─┬─► cardano_node_process ─► leios_voting ─► call_trace ─► loki.write.loki
//                             ├─► tx_firehose_process ───────────────────────► loki.write.loki
//                             └─► tx_centrifuge_process (dormant here) ───────► loki.write.loki

prometheus.remote_write "prometheus" {
	endpoint {
		url = "http://127.0.0.1:9090/api/v1/write"
	}
}

prometheus.scrape "cardano_node_exporter" {
	// One target per node, generated by run.sh from the node list so the
	// topology stays defined in exactly one place.
	targets = [
${SCRAPE_TARGETS}
	]

	metrics_path = "/metrics"

	scrape_timeout  = "1s"
	scrape_interval = "1s"

	forward_to = [prometheus.remote_write.prometheus.receiver]
}

loki.write "loki" {
	endpoint {
		url        = "http://localhost:3100/loki/api/v1/push"
		batch_size = "2MB"
	}
}

local.file_match "local_files" {
	path_targets = [{"__path__" = "${WORKING_DIR}/**/*.log"}]
	sync_period  = "5s"
}

loki.source.file "process_compose_log_scrape" {
	targets       = local.file_match.local_files.targets
	forward_to    = [loki.process.extract_process_compose_logs.receiver]
	tail_from_end = false
}

// FRONT-END (environment-specific) stage 1: unwrap the process-compose envelope
// and write ONE raw process-compose copy (service=process-compose). This stage
// does NOT route -- it hands each line to leios_route below, where the routing
// `service` value is stamped, so the raw copy is never overwritten by it.
loki.process "extract_process_compose_logs" {
	stage.json {
		expressions = {
			level   = "level",
			process = "process",
			replica = "replica",
			message = "message",
		}
		drop_malformed = true
	}

	// Lowercase the instance label so it matches the instance label on the
	// prometheus scrape targets above (bp1, relay11, ...) and playground's
	// lowercase-hostname convention. The shared dashboards source $instance from
	// Loki and use it in prometheus queries (instance=~"$instance", a
	// case-sensitive match), so a casing mismatch drops the metric panels when a
	// specific instance is selected.
	stage.template {
		source   = "instance"
		template = "{{ .process | ToLower }}"
	}

	stage.labels {
		values = {
			level    = "level",
			process  = "process",
			replica  = "replica",
			instance = "instance",
		}
	}

	stage.static_labels {
		values = {
			service = "process-compose",
		}
	}

	// Body = the wrapped trace JSON; the raw copy goes to loki.write.loki and a
	// copy is handed to leios_route for service stamping + fan-out.
	stage.output {
		source = "message"
	}

	forward_to = [
		loki.write.loki.receiver,
		loki.process.leios_route.receiver,
	]
}

// FRONT-END stage 2 (the router): overwrite `service` from process-compose to the
// normalized routing value (cardano-node | tx-firehose | tx-centrifuge) by process
// name, then fan out to the shared modules. `service` is BOTH the routing key and
// the final label -- there is no separate `stream`, so nothing needs dropping
// before the write. `Analyze` (and any non-matching process) keeps
// service=process-compose, so every module's `{service!="..."}` guard drops it.
loki.process "leios_route" {
	stage.match {
		selector = `{process=~"(bp|relay)[0-9]+"}`
		stage.static_labels {
			values = {
				service = "cardano-node",
			}
		}
	}

	stage.match {
		selector = `{process=~"TxFirehose.*"}`
		stage.static_labels {
			values = {
				service = "tx-firehose",
			}
		}
	}

	stage.match {
		selector = `{process="TxCentrifuge"}`
		stage.static_labels {
			values = {
				service = "tx-centrifuge",
			}
		}
	}

	forward_to = [
		mod.cardano_node_process.node.receiver,
		mod.tx_firehose_process.firehose.receiver,
		mod.tx_centrifuge_process.centrifuge.receiver,
	]
}

// Shared per-service enrichment modules (config/alloy-modules/*.alloy), placed into
// ${WORKING_DIR}/alloy-modules by run.sh. import.file on a directory exposes each
// file's `declare` under this namespace.
import.file "mod" {
	filename = "${WORKING_DIR}/alloy-modules"
}

// Node chain: cardano_node_process -> voting -> call-trace -> terminal write. Wiring lives
// here, not inside the modules.
mod.cardano_node_process "node" {
	forward_to = [mod.leios_voting_process.vote.receiver]
}

mod.leios_voting_process "vote" {
	forward_to = [mod.call_trace_process.call.receiver]
}

mod.call_trace_process "call" {
	forward_to = [loki.write.loki.receiver]
}

// tx-generator services: each writes directly (single write per line).
mod.tx_firehose_process "firehose" {
	forward_to = [loki.write.loki.receiver]
}

mod.tx_centrifuge_process "centrifuge" {
	forward_to = [loki.write.loki.receiver]
}

prometheus.scrape "alloy_pipeline_metrics" {
	// Tag the loki-derived counters (cardano_node_metrics_loki_*, incl. txgen_*)
	// with environment/instance/group so they carry the same labels as
	// playground's leios_alloy_pipeline_metrics scrape -- the shared throughput
	// dashboard selects them by environment="leios".
	targets = [{
		"__address__" = "localhost:12345",
		"instance"    = "dozen-devnet",
		"environment" = "leios",
		"group"       = "dozen-devnet",
	}]
	forward_to      = [prometheus.remote_write.prometheus.receiver]
	scrape_timeout  = "1s"
	scrape_interval = "1s"
}
